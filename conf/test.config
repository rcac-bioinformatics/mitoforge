/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Use as follows:

        bin/fetch_testdata.sh
        nextflow run . -profile test,docker --outdir results

    Test data (real, published, not simulated; fetched by bin/fetch_testdata.sh):

    HiFi path
      Reads     100 PacBio HiFi CCS reads from Deilephila porcellus (elephant hawk-moth),
                shipped with MitoHiFi as tests/ilDeiPorc1.reads.100.fa
                https://github.com/marcelauliano/MitoHiFi/blob/master/tests/ilDeiPorc1.reads.100.fa
      Reference GenBank MW539688.1, Theretra latreillii lucasii mitochondrion, complete
                genome. Same family (Sphingidae) as the sample. Shipped with MitoHiFi as
                tests/MW539688.1.fasta and tests/MW539688.1.gb
      Genetic code 5 (invertebrate mitochondrial)

    Short-read path
      Reads     The first 250,000 read pairs of SRA run SRR5201683, a whole-genome
                shotgun library from Myodes glareolus (bank vole). About 50 Mb of
                bases; enough for GetOrganelle to return a complete circular
                mitogenome. This reduced set is the one the GetOrganelle authors
                publish and document as their animal mitogenome example, made with

                    fastq-dump --origfmt --split-files -X 250000 --gzip SRR5201683

                https://www.ncbi.nlm.nih.gov/sra/SRR5201683
                https://github.com/Kinggerm/GetOrganelleGallery/tree/master/Test/reads
                bin/fetch_testdata.sh checks it against the md5 sums published in the
                GetOrganelle wiki.
      Reference GenBank PZ790849, Caryomys eva, complete mitochondrion. Same tribe
                (Myodini) as the bank vole, so this exercises the realistic case of
                assembling against a relative rather than the species itself.
                Deliberately not the bank vole's own RefSeq record NC_024538: that
                record carries no /gene= qualifiers, and MitoHiFi needs them to
                compare gene content, so it fails on the very last step.
      Genetic code 2 (vertebrate mitochondrial)
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus:   4,
        memory: '8.GB',
        time:   '1.h'
    ]
}

params {
    input = "${projectDir}/testdata/samplesheet_test.csv"
}
