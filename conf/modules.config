/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Per-module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys:
        ext.args   = extra arguments appended to the tool's command line
        ext.prefix = output file name prefix

    The MitoHiFi module declares `path("*")` as one of its outputs, which also matches
    the input files staged into the work directory - including the read files, which
    can be tens of gigabytes. Every MitoHiFi publishDir therefore names what it wants
    rather than taking everything.

    Two of MitoHiFi's own directories are deliberately left unpublished:
      potential_contigs/           per-contig MitoFinder working directories. One of
                                   them holds a symlink into a path that only existed
                                   inside the container, which no publish mode can
                                   copy. The contigs themselves are in
                                   all_potential_contigs.fa.
      reads_mapping_and_assembly/  hifiasm intermediates; large on a real sample.
    Both are still in the work directory if you need them for debugging.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    //
    // Reference lookup at NCBI. Reaches the internet; the cluster profiles pin this
    // to the login node.
    //
    withName: 'MITOHIFI_FINDMITOREFERENCE' {
        ext.args   = { "--min_length ${params.min_ref_length}" }
        // NCBI times out and rate-limits; that is worth another try.
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries    = 3
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/reference" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // Unaligned PacBio BAM -> FASTQ. Intermediate, not published.
    //
    withName: 'SAMTOOLS_FASTQ' {
        publishDir = [ enabled: false ]
    }

    //
    // MitoHiFi in reads mode: the HiFi assembly itself.
    //
    withName: 'MITOHIFI_MITOHIFI' {
        ext.args   = { params.mitohifi_percent_id ? "-p ${params.mitohifi_percent_id}" : '' }
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/assembly" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                filename.startsWith('final_mitogenome')
                    || filename.endsWith('.png')
                    || filename.endsWith('.log')
                    || filename in ['contigs_stats.tsv', 'shared_genes.tsv', 'all_potential_contigs.fa']
                    || filename in ['final_mitogenome_choice', 'contigs_circularization', 'contigs_filtering', 'coverage_mapping']
                    ? filename
                    : null
            }
        ]
    }

    //
    // MitoHiFi in contigs mode: the one finishing step every sample goes through.
    // Publishes twice - the finished mitogenome into a flat per-run folder that is
    // easy to hand to the next tool, and the full working output per sample.
    //
    withName: 'MITOHIFI_FINALIZE' {
        ext.args   = { params.mitohifi_percent_id ? "-p ${params.mitohifi_percent_id}" : '' }
        // The module is labelled process_high because reads mode needs it. Contigs
        // mode only ever sees a finished 16 kb assembly, so it gets a small share
        // instead - it makes a real difference across a hundred samples.
        cpus   = { 4     * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 4.h   * task.attempt }
        // One publishDir, routing each file to where it belongs: the three finished
        // files into a flat per-run folder named by sample, which is what you hand to
        // the next tool, and everything else into the sample's own folder.
        //
        // This is deliberately one publishDir rather than a list of two. Nextflow 26
        // cannot render a *list* of publishDir maps to JSON when any closure in it
        // mentions `meta`, which breaks `nextflow config -o json` and with it the
        // nf-core config linting. A single map is fine.
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                filename == 'final_mitogenome.fasta' ? "mitogenomes/${meta.id}.fasta"
                    : filename == 'final_mitogenome.gb' ? "mitogenomes/${meta.id}.gb"
                    : filename == 'final_mitogenome.gff' ? "mitogenomes/${meta.id}.gff"
                    : filename.endsWith('.png')
                        || filename.endsWith('.log')
                        || filename in ['contigs_stats.tsv', 'shared_genes.tsv', 'all_potential_contigs.fa']
                        || filename in ['final_mitogenome_choice', 'contigs_circularization', 'contigs_filtering', 'coverage_mapping']
                        ? "samples/${meta.id}/final/${filename}"
                        : null
            }
        ]
    }

    //
    // Illumina trimming. The trimmed reads themselves stay in the work directory;
    // only the reports are published, and they also go to MultiQC.
    //
    withName: 'FASTP' {
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/trimming" },
            mode: params.publish_dir_mode,
            pattern: '*.{json,html,log}'
        ]
    }

    //
    // GetOrganelle's seed and label databases. Downloaded once per run over the
    // internet, so the cluster profiles pin this to the login node.
    //
    withName: 'GETORGANELLE_CONFIG' {
        // Every short-read sample depends on this one download, so it retries rather
        // than being dropped, and a persistent failure stops the run instead of
        // quietly producing no Illumina results at all.
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
        maxRetries    = 3
        publishDir    = [ enabled: false ]
    }

    //
    // GetOrganelle assembly. Its output directory also holds the extended read files,
    // which are large, so only the assembly, the graph and the log are published.
    //
    withName: 'GETORGANELLE_FROMREADS' {
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/assembly" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                def name = filename.tokenize('/').last()
                name.endsWith('.fasta.gz') || name.endsWith('.log.txt') || name.endsWith('.gfa') ? name : null
            }
        ]
    }

    //
    // Uncompressing the GetOrganelle assembly for MitoHiFi. Intermediate.
    //
    withName: 'GUNZIP' {
        publishDir = [ enabled: false ]
    }

    //
    // Run summary
    //
    withName: 'MITOFORGE_SAMPLE_STATS' {
        publishDir = [ enabled: false ]
    }

    withName: 'MITOFORGE_SUMMARY' {
        // Run-level, not per-sample: if the summary cannot be written the run has
        // genuinely failed, and silently carrying on would hide it.
        errorStrategy = 'finish'
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: 'MULTIQC' {
        errorStrategy = 'finish'
        ext.args   = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
