/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Per-module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys:
        ext.args   = extra arguments appended to the tool's command line
        ext.prefix = output file name prefix

    The MitoHiFi module declares `path("*")` as one of its outputs, which also matches
    the input files staged into the work directory - including the read files, which
    can be tens of gigabytes. Every MitoHiFi publishDir therefore names what it wants
    rather than taking everything.

    Two of MitoHiFi's own directories are deliberately left unpublished:
      potential_contigs/           per-contig MitoFinder working directories. One of
                                   them holds a symlink into a path that only existed
                                   inside the container, which no publish mode can
                                   copy. The contigs themselves are in
                                   all_potential_contigs.fa.
      reads_mapping_and_assembly/  hifiasm intermediates; large on a real sample.
    Both are still in the work directory if you need them for debugging.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    //
    // Reference lookup at NCBI. Reaches the internet; the cluster profiles pin this
    // to the login node.
    //
    withName: '.*PREPARE_REFERENCE:MITOHIFI_FINDMITOREFERENCE' {
        ext.args   = { "--min_length ${params.min_ref_length}" }
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/reference" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // Unaligned PacBio BAM -> FASTQ. Intermediate, not published.
    //
    withName: '.*ASSEMBLE_HIFI:SAMTOOLS_FASTQ' {
        publishDir = [ enabled: false ]
    }

    //
    // MitoHiFi in reads mode: the HiFi assembly itself.
    //
    withName: '.*ASSEMBLE_HIFI:MITOHIFI_MITOHIFI' {
        ext.args   = { params.mitohifi_percent_id ? "-p ${params.mitohifi_percent_id}" : '' }
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/assembly" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                filename.startsWith('final_mitogenome')
                    || filename.endsWith('.png')
                    || filename.endsWith('.log')
                    || filename in ['contigs_stats.tsv', 'shared_genes.tsv', 'all_potential_contigs.fa']
                    || filename in ['final_mitogenome_choice', 'contigs_circularization', 'contigs_filtering', 'coverage_mapping']
                    ? filename
                    : null
            }
        ]
    }

    //
    // MitoHiFi in contigs mode: the one finishing step every sample goes through.
    // Publishes twice - the finished mitogenome into a flat per-run folder that is
    // easy to hand to the next tool, and the full working output per sample.
    //
    withName: '.*FINALIZE:MITOHIFI_FINALIZE' {
        ext.args   = { params.mitohifi_percent_id ? "-p ${params.mitohifi_percent_id}" : '' }
        publishDir = [
            [
                path: { "${params.outdir}/mitogenomes" },
                mode: params.publish_dir_mode,
                saveAs: { filename ->
                    filename == 'final_mitogenome.fasta' ? "${meta.id}.fasta"
                        : filename == 'final_mitogenome.gb' ? "${meta.id}.gb"
                        : filename == 'final_mitogenome.gff' ? "${meta.id}.gff"
                        : null
                }
            ],
            [
                path: { "${params.outdir}/samples/${meta.id}/final" },
                mode: params.publish_dir_mode,
                saveAs: { filename ->
                    filename.startsWith('final_mitogenome')
                        || filename.endsWith('.png')
                        || filename.endsWith('.log')
                        || filename in ['contigs_stats.tsv', 'shared_genes.tsv', 'all_potential_contigs.fa']
                        || filename in ['final_mitogenome_choice', 'contigs_circularization', 'contigs_filtering', 'coverage_mapping']
                        ? filename
                        : null
                }
            ]
        ]
    }

    //
    // Run summary
    //
    withName: '.*SUMMARY:MITOFORGE_SAMPLE_STATS' {
        publishDir = [ enabled: false ]
    }

    withName: '.*SUMMARY:MITOFORGE_SUMMARY' {
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
