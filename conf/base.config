/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    rcac-bioinformatics/mitoforge Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default resource requests, and what happens when a task fails.

    Sizing target: one sample is roughly 35 Gb of PacBio HiFi reads from a ~1 Gb
    nuclear genome, or an Illumina library of comparable depth. The expensive stage is
    pulling the mitochondrial reads out of that pile - minimap2 for MitoHiFi, bowtie2
    and SPAdes for GetOrganelle - so the heavy label is CPU-hungry rather than
    memory-hungry. Once the reads are baited, every later step works on 16 kb of
    sequence and is tiny; those are pinned down individually in conf/modules.config.

    Requests are deliberately kept inside what a single 256 GB compute node can give,
    so no label needs a fat node. Override per cluster with `process.resourceLimits`.
----------------------------------------------------------------------------------------
*/

process {

    cpus   = { 1    * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    //
    // One failed sample must never kill a run of a hundred.
    //
    // Exit codes 130-145 and 104 are the signals SLURM uses for out-of-memory and
    // out-of-time; 175-177 are the equivalents on some other schedulers. Those get
    // another attempt with more of everything, because `task.attempt` multiplies the
    // requests above. Anything else means the tool itself gave up on this sample, and
    // trying again with a bigger node will not change that, so the sample is dropped
    // and the run carries on. SUMMARY lists every sample that did not finish.
    //
    // Run-level processes override this back to 'finish' in conf/modules.config: if
    // the summary itself cannot be written, the run really has failed.
    //
    errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'ignore' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 8     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 16    * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { 24.h  * task.attempt }
    }
    withLabel:process_long {
        time   = { 48.h * task.attempt }
    }
    withLabel:process_low_memory {
        memory = { 1.GB * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 128.GB * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}
