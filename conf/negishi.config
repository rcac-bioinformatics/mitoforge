/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Negishi (Purdue RCAC) profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Cluster documentation: https://www.rcac.purdue.edu/knowledge/negishi

    STATUS: untested on cluster. Written from documentation on a laptop with no SLURM
    available. Please report anything that does not work.

    Usage:
        nextflow run . -profile negishi \\
            --input samplesheet.csv \\
            --outdir results \\
            --cluster_account <your allocation> \\
            --cluster_queue <partition>

    --cluster_account and --cluster_queue are both required. Run `slist` to see the
    allocations you belong to and `sinfo -s` to see the partitions available to you.

    Node sizes are deliberately not hard-coded here. The requests in conf/base.config
    stay inside a 256 GB node. If your partition is smaller, add to your own config:

        process.resourceLimits = [ cpus: 32, memory: '120.GB', time: '24.h' ]
----------------------------------------------------------------------------------------
*/

apptainer {
    enabled    = true
    autoMounts = true
    // Containers are large; keep one shared cache on scratch rather than one per run.
    cacheDir   = System.getenv('NXF_APPTAINER_CACHEDIR')
        ?: (System.getenv('RCAC_SCRATCH') ?: System.getenv('SCRATCH') ?: System.getenv('HOME')) + '/.apptainer_cache'
}
conda.enabled        = false
docker.enabled       = false
singularity.enabled  = false
podman.enabled       = false
shifter.enabled      = false
charliecloud.enabled = false

executor {
    name            = 'slurm'
    queueSize       = 50
    submitRateLimit = '10 sec'
}

process {
    executor       = 'slurm'
    queue          = { params.cluster_queue }
    clusterOptions = { "-A ${params.cluster_account}" }

    // Compute nodes on this cluster have no route to the internet. Anything that
    // reaches out to NCBI or to a container registry has to run on the login node.
    withName: 'MITOHIFI_FINDMITOREFERENCE' {
        executor       = 'local'
        clusterOptions = null
        queue          = null
    }
    withName: 'GETORGANELLE_CONFIG' {
        executor       = 'local'
        clusterOptions = null
        queue          = null
    }
}
