nextflow_process {

    name "Test process MITOFORGE_SUMMARY"
    script "../main.nf"
    process "MITOFORGE_SUMMARY"

    tag "modules"
    tag "modules_local"
    tag "mitoforge_summary"

    // Inputs are built by MITOFORGE_SAMPLE_STATS, so two of those runs are chained in
    // front of this one rather than hand-writing per-sample files.

    setup {
        run("MITOFORGE_SAMPLE_STATS") {
            script "../../mitoforge_sample_stats/main.nf"
            process {
                """
                input[0] = channel.of(
                    [
                        [ id: 'sampleB', platform: 'hifi', genetic_code: 5, ref_fa: file("\${projectDir}/testdata/hifi/MW539688.1.fasta", checkIfExists: true) ],
                        file("\${projectDir}/testdata/hifi/ilDeiPorc1.final_mitogenome.fasta", checkIfExists: true),
                        file("\${projectDir}/modules/local/mitoforge_sample_stats/tests/final_contigs_stats.tsv", checkIfExists: true),
                        file("\${projectDir}/modules/local/mitoforge_sample_stats/tests/assembly_contigs_stats.tsv", checkIfExists: true)
                    ],
                    [
                        [ id: 'sampleA', platform: 'illumina', genetic_code: 2, ref_fa: file("\${projectDir}/testdata/hifi/MW539688.1.fasta", checkIfExists: true) ],
                        file("\${projectDir}/testdata/hifi/ilDeiPorc1.final_mitogenome.fasta", checkIfExists: true),
                        file("\${projectDir}/modules/local/mitoforge_sample_stats/tests/final_contigs_stats.tsv", checkIfExists: true),
                        []
                    ]
                )
                """
            }
        }
    }

    test("stacks every sample into one summary and one contig table") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = MITOFORGE_SAMPLE_STATS.out.summary.map { _meta, tsv -> tsv }.collect()
                input[1] = MITOFORGE_SAMPLE_STATS.out.contigs_stats.map { _meta, tsv -> tsv }.collect()
                """
            }
        }

        then {
            def summary = path(process.out.summary[0]).readLines()
            def contigs = path(process.out.all_contigs_stats[0]).readLines()
            def mqc     = path(process.out.mqc[0]).readLines()
            assertAll(
                { assert process.success },
                { assert summary[0] == 'sample\tplatform\tgenetic_code\treference\tlength_bp\tgenes\tcircular\tframeshifts\tstatus' },
                { assert summary.size() == 3 },
                // sorted by sample name, so the table is stable between runs
                { assert summary[1].startsWith('sampleA\t') },
                { assert summary[2].startsWith('sampleB\t') },
                // one header, then every sample's contig rows
                { assert contigs[0].startsWith('sample\tstage\t') },
                { assert contigs.findAll { line -> line.startsWith('sample\tstage\t') }.size() == 1 },
                { assert contigs.any { line -> line.startsWith('sampleA\t') } },
                { assert contigs.any { line -> line.startsWith('sampleB\t') } },
                // the MultiQC copy carries the custom-content header
                { assert mqc[0].contains('rcac-bioinformatics-mitoforge-summary') },
                { assert mqc.any { line -> line.startsWith('# plot_type: "table"') } }
            )
        }
    }

    test("stub") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = MITOFORGE_SAMPLE_STATS.out.summary.map { _meta, tsv -> tsv }.collect()
                input[1] = MITOFORGE_SAMPLE_STATS.out.contigs_stats.map { _meta, tsv -> tsv }.collect()
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
