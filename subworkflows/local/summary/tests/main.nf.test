nextflow_workflow {

    name "Test subworkflow SUMMARY"
    script "../main.nf"
    workflow "SUMMARY"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "summary"

    test("one sample with assembly stats, one without, one that failed") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                def hifi_meta  = [ id: 'hifiA',  platform: 'hifi',     genetic_code: 5, ref_source: 'file',    ref_fa: file("${projectDir}/testdata/hifi/MW539688.1.fasta", checkIfExists: true) ]
                def short_meta = [ id: 'shortA', platform: 'illumina', genetic_code: 2, ref_source: 'file',    ref_fa: file("${projectDir}/testdata/hifi/MW539688.1.fasta", checkIfExists: true) ]
                def lost_meta  = [ id: 'lostA',  platform: 'hifi',     genetic_code: 5, ref_source: 'species', species: 'Deilephila porcellus', ref_fa: null ]
                def mitogenome = file("${projectDir}/testdata/hifi/ilDeiPorc1.final_mitogenome.fasta", checkIfExists: true)
                def reads          = file("${projectDir}/testdata/hifi/ilDeiPorc1.reads.100.fa", checkIfExists: true)
                def final_stats    = file("${projectDir}/modules/local/mitoforge_sample_stats/tests/final_contigs_stats.tsv", checkIfExists: true)
                def assembly_stats = file("${projectDir}/modules/local/mitoforge_sample_stats/tests/assembly_contigs_stats.tsv", checkIfExists: true)

                // all three samples were in the samplesheet
                input[0] = channel.of([ hifi_meta, [ reads ] ], [ short_meta, [ reads ] ], [ lost_meta, [ reads ] ])
                // lostA never got a reference
                input[1] = channel.of([ hifi_meta, mitogenome, mitogenome ], [ short_meta, mitogenome, mitogenome ])
                input[2] = channel.of([ hifi_meta, mitogenome ], [ short_meta, mitogenome ])
                input[3] = channel.of([ hifi_meta, mitogenome ], [ short_meta, mitogenome ])
                input[4] = channel.of([ hifi_meta, final_stats ], [ short_meta, final_stats ])
                // only the hifi sample has an assembly-stage table
                input[5] = channel.of([ hifi_meta, assembly_stats ])
                """
            }
        }

        then {
            def summary = path(workflow.out.summary[0]).readLines()
            assertAll(
                { assert workflow.success },
                { assert summary.size() == 4 },
                { assert summary[1].startsWith('hifiA\t') },
                { assert summary[2].startsWith('lostA\t') },
                { assert summary[3].startsWith('shortA\t') },
                // the hifi sample's assembly table says it was circularised; the
                // short-read sample only has the finishing table, which says it was not
                { assert summary[1].split('\t')[6] == 'True' },
                { assert summary[3].split('\t')[6] == 'False' },
                // the sample that never got a reference is named, not dropped
                { assert summary[2].split('\t').last() == 'failed: no reference' },
                { assert summary[2].split('\t')[3] == 'species:Deilephila porcellus' },
                { assert path(workflow.out.multiqc[0]).text.contains('plot_type') }
            )
        }
    }
}
